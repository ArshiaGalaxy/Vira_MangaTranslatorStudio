{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vira",
  "version": "1.0.0",
  "identifier": "com.vira.translatorstudio",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Vira Translator Studio",
        "width": 980,
        "height": 660,
        "minWidth": 760,
        "minHeight": 520,
        "center": true,
        "resizable": true,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "GraphicsAndDesign",
    "publisher": "Arshia",
    "homepage": "https://github.com/ArshiaGalaxy/Vira_MangaTranslatorStudio",
    "shortDescription": "Vira Manga Translator Studio",
    "longDescription": "Vira Manga Translator Studio — desktop launcher for the Django backend and Next.js studio frontend.",
    "icon": [
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png"
    ],
    "resources": {
      "../payload": "payload"
    },
    "targets": ["nsis"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    }
  }
}
